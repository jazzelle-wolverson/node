<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Products</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  </head>
  <body>
    <nav class="bg-secondary text-center">
        <a class="text-white text-decoration-none" href="/">Home</a>
        <a class="text-white text-decoration-none" href="/products">Products</a>
        <hr class="bg-black">
    </nav>  
    <main>
      <div class="container-fluid text-center">
        <div class="row bg-secondary">
          <div class="col bg-secondary-emphasis">
            <h1>Products bruh</h1>
          </div>
        </div>
        <div class="row">
          <div class="col">
            <ul>
              |<% for (let i = 0; i < products.length; i++) {%>
                <span>Product Number: <%= products[i].productNumber %></span> -
                <span>Title: <%= products[i].title %></span> -
                <span>Price: <%= products[i].price %></span> -
                <span>Category: <%= products[i].category %></span> -
                <span>Description: <%= products[i].description %></span> - 
                <a href="/product/<%= products[i].productNumber %>" >Edit Product</a> | 
              <% } %>
            </ul>
          </div>
        </div>
        <div class="row">
          <div class="col">
            <h2>Add Product bruh</h2>
          </div>
        </div>
        <div class="row">
          <div class="col">
            <form action="/product" method="POST">
              <label>Badge Number: </label>
              <input type="text" name="productNumber" />
              <label>Name: </label>
              <input type="text" name="name" />
              <label>Title: </label>
              <input type="text" name="title" />
              <button class="btn btn-warning" type="submit">Add Product</button>
            </form>            
          </div>
        </div>
      </div>
    </main>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  </body>
</html>